<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Sdmm.Core</RootNamespace>
    <!-- Turns reflection-based serialization or other trim/AOT-unsafe code into build errors (warnings are errors). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sdmm.Core.Tests" />
  </ItemGroup>

</Project>
