<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sdmm.App</RootNamespace>
    <AssemblyName>SatisfactoryDevModManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe icon (Explorer, taskbar pin). Generated by tools/icon/make-icon.cs; see the README. -->
    <ApplicationIcon>Assets\sdmm.ico</ApplicationIcon>
    <!-- Single self-contained exe for publish (see build.ps1 -Publish). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window title-bar and taskbar icon at runtime. -->
    <Resource Include="Assets\sdmm.ico" />
    <Resource Include="Assets\sdmm-256.png" />
    <Resource Include="Assets\variant.ico" />
    <Resource Include="Assets\variant-256.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sdmm.Core\Sdmm.Core.csproj" />
    <ProjectReference Include="..\Sdmm.Remote\Sdmm.Remote.csproj" />
  </ItemGroup>

</Project>
