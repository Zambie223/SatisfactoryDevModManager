<Window x:Class="Sdmm.App.ServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sdmm.App"
        Title="Hosted server" Width="580" SizeToContent="Height" ResizeMode="NoResize"
        Icon="{Binding Icon, Source={x:Static local:Brand.Current}}"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,14,18,16">
        <TextBlock Style="{StaticResource Hint}"
                   Text="Copy the SFTP (or FTP) login from your host's panel. 'Game folder' is the folder that contains FactoryGame. If you're not sure, leave it as / and click Test connection: SDMM looks for it." />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
                </Style>
            </Grid.Resources>
            <TextBlock Grid.Row="0" Text="Name" VerticalAlignment="Center" />
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3" />

            <TextBlock Grid.Row="1" Text="Protocol" VerticalAlignment="Center" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                <RadioButton x:Name="SftpRadio" Content="SFTP" GroupName="proto" Margin="0,0,12,0" Checked="OnProtocolChanged" />
                <RadioButton x:Name="FtpRadio" Content="FTP" GroupName="proto" Checked="OnProtocolChanged" />
                <CheckBox x:Name="FtpsBox" Content="Use FTPS (TLS)" Margin="18,0,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Host" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="HostBox" Margin="0,3" />

            <TextBlock Grid.Row="3" Text="Port" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="PortBox" Width="80" HorizontalAlignment="Left" Margin="0,3" />

            <TextBlock Grid.Row="4" Text="User name" VerticalAlignment="Center" />
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="UserBox" Margin="0,3" />

            <TextBlock Grid.Row="5" Text="Password" VerticalAlignment="Center" />
            <StackPanel Grid.Row="5" Grid.Column="1" Margin="0,3">
                <PasswordBox x:Name="PasswordBox" />
                <TextBlock x:Name="PasswordHint" Style="{StaticResource Hint}" Margin="0,1,0,0" />
            </StackPanel>

            <TextBlock Grid.Row="6" Text="Private key (SFTP)" VerticalAlignment="Center" />
            <DockPanel Grid.Row="6" Grid.Column="1" Margin="0,3">
                <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseKey" Margin="6,0,0,0" />
                <TextBox x:Name="KeyBox" />
            </DockPanel>

            <TextBlock Grid.Row="7" Text="Game folder" VerticalAlignment="Center" />
            <TextBox Grid.Row="7" Grid.Column="1" x:Name="PathBox" Margin="0,3" />

            <TextBlock Grid.Row="8" Text="Platform" VerticalAlignment="Center" />
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,3">
                <ComboBox x:Name="TargetBox" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Detect automatically" Tag="" />
                    <ComboBoxItem Content="LinuxServer" Tag="LinuxServer" />
                    <ComboBoxItem Content="WindowsServer" Tag="WindowsServer" />
                </ComboBox>
                <TextBlock Style="{StaticResource Hint}" Margin="0,1,0,0" Text="Only set this if the host hides the Engine folder, so the platform can't be detected." />
            </StackPanel>

            <TextBlock Grid.Row="9" Text="Saved key" VerticalAlignment="Center" />
            <DockPanel Grid.Row="9" Grid.Column="1" Margin="0,3">
                <Button DockPanel.Dock="Right" Content="Forget" Click="OnForgetKey" Margin="6,0,0,0" />
                <TextBox x:Name="FingerprintBox" IsReadOnly="True" Foreground="{StaticResource SubtleTextBrush}" />
            </DockPanel>
        </Grid>
        <TextBlock x:Name="TestResult" TextWrapping="Wrap" Margin="0,10,0,0" />
        <DockPanel Margin="0,14,0,0">
            <Button x:Name="TestButton" DockPanel.Dock="Left" Style="{StaticResource GreyButton}" Content="Test connection" Click="OnTest"
                    ToolTip="Connects with these settings and checks the game folder, without saving" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource AccentButton}" Content="Save" IsDefault="True" Click="OnSave" />
                <Button Content="Cancel" IsCancel="True" Margin="0" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
