<Window x:Class="Sdmm.App.AddServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sdmm.App"
        Title="Add a server" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        Icon="{Binding Icon, Source={x:Static local:Brand.Current}}"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontSize="13"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <!-- A large two-line choice button -->
        <Style x:Key="ChoiceButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="18,14,18,16">
        <TextBlock Style="{StaticResource Hint}" Text="Where does the server run?" Margin="0,0,0,10" />

        <Button Style="{StaticResource ChoiceButton}" Click="OnHosted" AutomationProperties.Name="Hosted server">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE753;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="Hosted server" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"
                               Text="Rented from a host such as Indifferent Broccoli or G-Portal. SDMM connects with the SFTP or FTP login shown in your host's panel." />
                </StackPanel>
            </DockPanel>
        </Button>

        <Button Style="{StaticResource ChoiceButton}" Click="OnThisPc" AutomationProperties.Name="Dedicated server on this PC">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="26"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <StackPanel>
                    <TextBlock Text="Dedicated server on this PC" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,3,0,0"
                               Text="Steam's free Satisfactory Dedicated Server, or one you installed yourself. SDMM finds Steam's automatically, or you pick its folder." />
                </StackPanel>
            </DockPanel>
        </Button>

        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                   Text="Hosting a game from your own Satisfactory client (not a dedicated server)? That's your game: manage it under My game." />
        <Button Content="Cancel" IsCancel="True" HorizontalAlignment="Right" Margin="0" />
    </StackPanel>
</Window>
