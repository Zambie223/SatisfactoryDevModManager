<Window x:Class="Sdmm.App.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sdmm.App"
        Title="Update available" Width="620" SizeToContent="Height" ResizeMode="NoResize"
        Icon="{Binding Icon, Source={x:Static local:Brand.Current}}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <StackPanel Margin="24,20,24,20">
        <StackPanel Orientation="Horizontal">
            <Image Source="{Binding Logo, Source={x:Static local:Brand.Current}}" Width="64" Height="64" Margin="0,0,16,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="SubText" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>

        <TextBlock Style="{StaticResource Header}" Text="What's new" Margin="0,18,0,6" />
        <Border Background="{StaticResource BgBrush}" CornerRadius="3" Padding="12,10" MaxHeight="240">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
            </ScrollViewer>
        </Border>

        <WrapPanel HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="UpdateButton" Style="{StaticResource AccentButton}" Content="Update now" IsDefault="True" Click="OnUpdate" Padding="16,8" />
            <Button Style="{StaticResource GreyButton}" Content="Ask me later" IsCancel="True" Click="OnLater" Padding="16,8" />
            <Button Style="{StaticResource GreyButton}" Content="Skip this version" Click="OnSkip" Padding="16,8" Margin="0" />
        </WrapPanel>

        <Border Background="{StaticResource BgBrush}" CornerRadius="3" Padding="12,9" Margin="0,16,0,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE946;" FontFamily="{StaticResource IconFont}" Foreground="{DynamicResource AccentBrush}"
                           FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
            </DockPanel>
        </Border>
    </StackPanel>
</Window>
