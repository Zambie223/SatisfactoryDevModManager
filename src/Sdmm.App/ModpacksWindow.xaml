<Window x:Class="Sdmm.App.ModpacksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sdmm.App"
        xmlns:vm="clr-namespace:Sdmm.App.ViewModels"
        Title="Modpacks" Width="1080" Height="680" MinWidth="820" MinHeight="420"
        Icon="{Binding Icon, Source={x:Static local:Brand.Current}}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <Grid Margin="18,14,18,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===== Modpack list ===== -->
        <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Header}" Text="Modpacks" Margin="0,0,0,6" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <Button Style="{StaticResource AccentButton}" Content="Save selected install as a modpack" Command="{Binding NewFromInstallCommand}"
                        HorizontalContentAlignment="Center" Margin="0,0,0,6"
                        ToolTip="Records every mod installed in the game or server picked in the main window, with its version" />
                <UniformGrid Columns="2">
                    <Button Style="{StaticResource GreyButton}" Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,3,6" />
                    <Button Style="{StaticResource GreyButton}" Content="Export…" Command="{Binding ExportCommand}" Margin="3,0,0,6" />
                </UniformGrid>
                <Button Style="{StaticResource GreyButton}" Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,0,6" />
                <!-- SMM profiles as modpacks -->
                <StackPanel Visibility="{Binding IsVariant, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="From an SMM profile" Foreground="{StaticResource SubtleTextBrush}" Margin="0,6,0,4" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GreyButton}" Content="Import" Command="{Binding ImportSmmProfileCommand}" Margin="6,0,0,0" />
                        <ComboBox ItemsSource="{Binding SmmProfiles}" SelectedItem="{Binding SelectedSmmProfile}" Background="{StaticResource ControlOnPanelBrush}" />
                    </DockPanel>
                </StackPanel>
            </StackPanel>
            <ListBox ItemsSource="{Binding Packs}" SelectedItem="{Binding Selected}" Background="{StaticResource BgBrush}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ModpackItem}">
                        <StackPanel Margin="4,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Selected modpack ===== -->
        <Grid Grid.Column="2">
            <TextBlock Text="No modpack yet. Save the selected game or server as one, or import a modpack file."
                       Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}" />
            <DockPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Name" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Selected.Name, UpdateSourceTrigger=LostFocus}" FontSize="15" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding TargetText}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <CheckBox Content="Remove SDMM-managed mods that aren't in the modpack" IsChecked="{Binding RemoveOthers}" Margin="0,0,0,4"
                              ToolTip="Mods SMM, the host or a hand copy installed are never removed; they're only listed" />
                    <CheckBox Content="Use the newest versions that fit, instead of the saved versions" IsChecked="{Binding UseNewest}" Margin="0,0,0,8" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" Margin="8,0,0,0" />
                        <Button Style="{StaticResource AccentButton}" Command="{Binding ApplyCommand}" HorizontalAlignment="Left" Padding="16,8"
                                ToolTip="Shows everything that will change, then installs, updates and removes mods to match the modpack">
                            <TextBlock>
                                <Run Text="Apply to " /><Run Text="{Binding Main.SelectedInstall.Name, Mode=OneWay}" />
                            </TextBlock>
                        </Button>
                    </DockPanel>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Selected.Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" RowHeight="NaN">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="On" Width="62">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                              ToolTip="Switched-off mods are kept in the modpack but not installed" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Mod" Binding="{Binding ModReference}" Width="*" IsReadOnly="True" />
                        <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="120" IsReadOnly="True" />
                        <DataGridTextColumn Header="From" Binding="{Binding SourceText}" Width="150" IsReadOnly="True" />
                        <DataGridTemplateColumn Header="Goes on" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:ModpackModRow.SideOptions}}" SelectedItem="{Binding SideText, UpdateSourceTrigger=PropertyChanged}"
                                              Background="{StaticResource ControlOnPanelBrush}"
                                              ToolTip="Both: games and servers. Players only / Server only: skipped on the other kind of install." />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="44">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Remove from the modpack"
                                            Command="{Binding DataContext.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
