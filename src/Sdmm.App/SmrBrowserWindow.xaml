<Window x:Class="Sdmm.App.SmrBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Sdmm.App"
        xmlns:vm="clr-namespace:Sdmm.App.ViewModels"
        Title="Browse SMR" Width="1180" Height="760" MinWidth="900" MinHeight="480"
        Icon="{Binding Icon, Source={x:Static local:Brand.Current}}" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <!-- ===== Search and results ===== -->
        <DockPanel Grid.Column="0">
            <Grid DockPanel.Dock="Top" Background="{StaticResource BgBrush}">
                <Grid Margin="12,8,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="180" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource ControlBrush}"
                                 BorderThickness="0" Padding="30,12,12,12" />
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource SubtleTextBrush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False" />
                        <TextBlock Text="Search SMR" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="32,0,0,0"
                                   IsHitTestVisible="False" Visibility="{Binding SearchText, Converter={StaticResource EmptyToVisible}}" />
                    </Grid>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Source={x:Static vm:SmrBrowserViewModel.SortOptions}}"
                              SelectedItem="{Binding SelectedSort}" Margin="8,0,0,0" />
                </Grid>
            </Grid>
            <Border DockPanel.Dock="Top" Background="{DynamicResource SelectionBrush}" Padding="14,6">
                <TextBlock Text="{Binding TargetText}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar DockPanel.Dock="Top" IsIndeterminate="{Binding IsLoading}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            <DockPanel DockPanel.Dock="Bottom" Background="{StaticResource BgBrush}">
                <Button DockPanel.Dock="Right" Style="{StaticResource GreyButton}" Content="Load more" Command="{Binding LoadMoreCommand}" Margin="8,6,12,6" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center" Margin="12,0" />
            </DockPanel>
            <ListBox ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" ItemContainerStyle="{StaticResource ModRowItem}" Padding="0,4"
                     Background="{StaticResource PanelBrush}" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:SmrResultRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="58" Height="58" Margin="0,0,12,0">
                                <Border CornerRadius="4" Background="{Binding TileBrush}">
                                    <TextBlock Text="{Binding Initials}" FontFamily="Bahnschrift" FontWeight="Bold" FontSize="22"
                                               Foreground="#F6F1E7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border CornerRadius="4" Visibility="{Binding HasLogo, Converter={StaticResource BoolToVis}}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding Logo}" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Name, Mode=OneWay}" FontSize="15" FontWeight="SemiBold" />
                                    <Run Text=" by " Foreground="{StaticResource SubtleTextBrush}" />
                                    <Run Text="{Binding Authors, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                                    <InlineUIContainer BaselineAlignment="Center">
                                        <Border CornerRadius="3" BorderThickness="1" BorderBrush="{StaticResource OkBrush}" Padding="5,0" Margin="8,0,0,0"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding InstalledText}" Foreground="{StaticResource OkBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </InlineUIContainer>
                                </TextBlock>
                                <TextBlock Text="{Binding ShortDescription}" Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,3" />
                                <TextBlock Text="{Binding Stats}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- ===== Selected mod ===== -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BgBrush}" BorderThickness="6,0,0,0">
            <Grid Margin="18,16,18,14">
                <TextBlock Text="Pick a mod to see its versions and install it." Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                           Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}" />
                <DockPanel Visibility="{Binding Selected, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0">
                            <Run Text="by " Foreground="{StaticResource SubtleTextBrush}" />
                            <Run Text="{Binding Selected.Authors, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}" />
                        </TextBlock>
                        <TextBlock Text="{Binding Selected.ModReference}" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding Selected.ShortDescription}" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Selected.InstalledText}" Foreground="{StaticResource OkBrush}" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Visibility="{Binding Selected.IsInstalled, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Style="{StaticResource Header}" Text="Version" Margin="0,16,0,6" />
                        <ComboBox ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="Display"
                                  Background="{StaticResource ControlOnPanelBrush}" />
                        <TextBlock Text="{Binding VersionNote}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Visibility="{Binding VersionNote, Converter={StaticResource EmptyToCollapsed}}" />
                        <Button Style="{StaticResource AccentButton}" Content="Install" Command="{Binding InstallCommand}" Margin="0,12,0,0" Padding="12,8"
                                HorizontalContentAlignment="Center"
                                ToolTip="Installs this mod and anything it needs into the selected game or server. Shows what will change first." />
                        <Button Style="{StaticResource GreyButton}" Margin="0,8,0,0" HorizontalContentAlignment="Center" Command="{Binding OpenPageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="View on ficsit.app" />
                                <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource Header}" Text="Changes in this version" Margin="0,18,0,6" />
                    </StackPanel>
                    <Border Background="{StaticResource BgBrush}" CornerRadius="3" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Changelog}" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
