<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- Used when building without tools\env.ps1 (for example from an IDE): keeps packages inside the repo instead
         of the user profile. tools\env.ps1 sets NUGET_PACKAGES, which takes precedence over this. -->
    <add key="globalPackagesFolder" value=".cache/nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
