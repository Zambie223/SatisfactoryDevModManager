<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows: the command-line project (and DPAPI) are Windows-only. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- xunit.v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdmm.Core\Sdmm.Core.csproj" />
    <ProjectReference Include="..\..\src\Sdmm.Remote\Sdmm.Remote.csproj" />
    <ProjectReference Include="..\..\src\Sdmm.Cli\Sdmm.Cli.csproj" />
  </ItemGroup>

</Project>
